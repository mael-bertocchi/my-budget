# Global configuration
NODE_ENV="development"
PORT="3000"

# Database configuration
DATABASE_URL="postgresql://username:password@localhost:5432/my_budget"

# Single-user credentials (the only account that can sign in)
IDENTITY_USERNAME="you"
IDENTITY_PASSWORD="change-me-at-least-8-chars"

# JWT configuration
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"
