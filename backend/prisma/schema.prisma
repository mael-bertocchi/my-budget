// my-budget — personal budget tracker backend.
// Conventions: string PKs (the client mints stable ids such as "groceries" or a UUID),
// camelCase fields mapped to snake_case columns/tables, created/updated timestamps.
// Single tenant: the whole dataset belongs to the one env-configured owner, so the
// entities carry no user foreign key. The datasource connection URL is supplied at
// runtime via prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "./generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MovementKind {
  DEPOSIT
  WITHDRAWAL
}

model RefreshSession {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_sessions")
}

model Category {
  id           String   @id
  name         String
  symbol       String
  colorHex     Int      @map("color_hex")
  monthlyLimit Float    @default(0) @map("monthly_limit")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Operation {
  id           String   @id
  date         DateTime
  name         String
  categoryId   String   @map("category_id")
  location     String?
  amount       Float
  currencyCode String   @default("EUR") @map("currency_code")
  rateToEuro   Float    @default(1) @map("rate_to_euro")
  isRecurring  Boolean  @default(false) @map("is_recurring")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([categoryId])
  @@map("operations")
}

model SavingsGoal {
  id        String   @id
  name      String
  symbol    String
  colorHex  Int      @map("color_hex")
  saved     Float    @default(0)
  target    Float    @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("savings_goals")
}

model SavingsMovement {
  id        String       @id
  date      DateTime
  name      String
  note      String?
  amount    Float
  kind      MovementKind
  goalId    String?      @map("goal_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([date])
  @@map("savings_movements")
}

model BudgetState {
  id             String   @id
  monthlyLimit   Float    @default(3000) @map("monthly_limit")
  savingsBalance Float    @default(0) @map("savings_balance")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("budget_state")
}
